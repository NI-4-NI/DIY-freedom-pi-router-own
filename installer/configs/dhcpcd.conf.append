
# === freedom-pi router config ===

# eth0 = WAN. Longer timeout + reboot retry so the modem has time to hand out
# a lease after bridge-mode switches or cold boots. metric 100 ensures WAN
# route wins over any accidental secondary route.
interface eth0
metric 100
timeout 60
reboot 30

interface eth1
static ip_address={{LAN_GATEWAY}}/24

interface wlan0
static ip_address={{WIFI_GATEWAY}}/24
nohook wpa_supplicant
